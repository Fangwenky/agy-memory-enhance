{
  "agy-memory": {
    "SessionStart": [
      { "type": "command", "command": "python3 ./hooks/session_start.py", "timeout": 5 }
    ],
    "PreInvocation": [
      { "type": "command", "command": "python3 ./hooks/pre_invocation.py", "timeout": 10 }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [{ "type": "command", "command": "python3 ./hooks/post_tool_use.py", "timeout": 5 }]
      },
      {
        "matcher": "edit_file",
        "hooks": [{ "type": "command", "command": "python3 ./hooks/post_tool_use.py", "timeout": 5 }]
      },
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "python3 ./hooks/post_tool_use.py", "timeout": 5 }]
      }
    ]
  }
}
